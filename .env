# Conexão com o PostgreSQL do Supabase - usado por src/Conexao.php
# Este arquivo NÃO pode ir para o Git e NÃO pode ficar acessível pelo navegador.

# No painel do Supabase: clique em "Connect" (topo da página) > "Session pooler"
# e copie o host. Formato: aws-N-REGIAO.pooler.supabase.com
# (usa o pooler porque a conexão direta do plano gratuito só funciona em IPv6)
DB_HOST=COLE_AQUI_O_HOST_DO_SESSION_POOLER
DB_PORT=5432
DB_NAME=postgres

# Usuário no pooler = esg_app.<PROJECT_REF>
DB_USER=esg_app.whpepwjxnmtsgrcyeuaq

# A mesma senha que você colocou no CREATE ROLE do script SQL
DB_PASS=Algoritmo002.
DB_SSLMODE=require